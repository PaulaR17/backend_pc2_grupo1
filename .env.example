#plantilla del .env que necesita el backend.
#copia este fichero a ".env" en local y rellena los valores con secretos reales.
#nunca subir el .env real a git.

APP_NAME=PC2
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

#base de datos (en docker-compose se sobreescribe a host=postgres)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pc2_grupo1
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

#JWT (generar con: php artisan jwt:secret)
JWT_SECRET=
JWT_ALGO=RS512
JWT_PRIVATE_KEY=file://../storage/certs/jwt-rsa-4096-private.pem
JWT_PUBLIC_KEY=file://../storage/certs/jwt-rsa-4096-public.pem
JWT_PASSPHRASE=

#integracion con PC1 (Python ML)
ML_USE_SSH=false
ML_SSH_USER=
ML_SSH_HOST=
ML_REMOTE_PROJECT_PATH=
ML_REMOTE_PYTHON_BIN=
ML_PROJECT_PATH=../Proyecto-de-Computacion-I
ML_PYTHON_BIN=python3

#Open Route Service (para calculo de rutas)
ORS_API_KEY=
